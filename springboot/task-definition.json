{
  "family": "dockin-task",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "spring-boot-container",
      "image": "055447613012.dkr.ecr.ap-northeast-2.amazonaws.com/dockin-hackathon:latest",
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 8081,
          "protocol": "tcp"
        }
      ],
      "essential": true
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::055447613012:role/ecsTaskExecutionRole"
}